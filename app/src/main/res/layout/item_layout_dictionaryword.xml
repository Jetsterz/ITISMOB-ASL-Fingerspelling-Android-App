<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="#FAFAFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Word Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/wordName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/word_name_bg"
                android:fontFamily="@font/inter_family"
                android:gravity="center"
                android:padding="8dp"
                android:text="Dictionary Word"
                android:textColor="#4C4DDC"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Word Details -->
        <TextView
            android:id="@+id/dWordDef"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:maxLines="3"
            android:text="Word definition goes here"
            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <!-- Category -->
        <TextView
            android:id="@+id/dCatView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/category_bg"
            android:fontFamily="@font/inter_family"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Category"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:id="@+id/buttonLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_view"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="View word"
                app:srcCompat="@drawable/watchoreditvid"
                android:scaleType="fitCenter"
                app:tint="#4C4DDC" />

            <ImageButton
                android:id="@+id/btn_practice"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Practice word"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/hand"
                app:tint="#4C4DDC" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>